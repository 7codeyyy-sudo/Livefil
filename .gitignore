# 依赖与包管理器产物
node_modules/
.pnp.*
.yarn/

# 项目内运行数据（不入库）
# 注意 `.runtime/` 已覆盖 `.runtime/probes/`——FND-007 的提交前检查验收脚本
# 会在该目录下建临时 git 沙箱，沙箱及其一次性仓库都不会进入版本库。
.runtime/
.cache/
.data/

# 本地环境变量与秘密
.env
.env.local
.env.*.local

# Next.js 构建产物
.next/
out/
next-env.d.ts

# 构建、测试与覆盖率产物
dist/
build/
coverage/
*.tsbuildinfo

# 测试产物兜底。
# 项目内配置已把 Playwright 的输出指向 .cache/playwright/，但直接执行
# `npx playwright test`（绕过项目脚本）时，工具会按默认值把结果写到项目根。
test-results/
playwright-report/
blob-report/

# 日志与临时文件
*.log
npm-debug.log*
yarn-error.log*

# Git 钩子：`.husky/pre-commit` 等手工维护的钩子文件要提交；
# `.husky/_/` 是 husky 在 `prepare` 时生成的引导层（它自己也会在里面写一份
# 内容为 `*` 的 .gitignore），属于生成物，这里再显式声明一次以防误提交。
.husky/_/

# 编辑器与操作系统
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
