{
  "name": "livefil",
  "version": "0.1.0",
  "private": true,
  "description": "Livefil 个人生活管理与自律系统：目标 → 行动 → 今日排程 → 实际执行 → 开销/状态记录 → 日周复盘 → 下一步调整",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.2 <23.0.0",
    "npm": ">=10.9.8"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --cache --cache-location .cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint/.eslintcache",
    "format": "prettier --write . --cache --cache-location .cache/prettier/.prettier-cache",
    "format:check": "prettier --check . --cache --cache-location .cache/prettier/.prettier-cache",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.mjs\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "env:bootstrap": "node scripts/env/bootstrap.mjs",
    "env:check": "node scripts/env/check.mjs",
    "env:npm": "node scripts/env/npm.mjs",
    "env:install": "node scripts/env/npm.mjs install"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
