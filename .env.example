# Livefil 环境变量模板
#
# 使用方式：复制本文件为 .env.local 并填写真实取值。
# .env.local 已被 .gitignore 忽略，禁止提交到版本库。
# 本文件只保留变量名与说明，不得写入任何真实密钥。

# PostgreSQL 连接串。本地开发默认由 docker/compose.dev.yaml 提供实例。
# 格式：postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# 会话与令牌签名密钥，必须为足够长的随机字符串，仅服务端读取。
AUTH_SECRET=

# AI 供应商适配器标识：mock 表示本地 Mock，不发起外部请求。
AI_PROVIDER=mock

# AI 供应商密钥，仅服务端读取，禁止出现在前端代码、日志或测试数据中。
AI_API_KEY=

# 日志级别：debug | info | warn | error
LOG_LEVEL=debug

# 以下变量供 docker/compose.dev.yaml 使用，留空则使用该文件中的本地开发默认值。
# 本地开发库仅绑定回环地址，默认值不得用于任何非本地环境。
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
