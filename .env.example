# Livefil 环境变量模板
#
# 使用方式：复制本文件为 .env.local 并填写真实取值。
# 处理规则：
#   1. .env.local 只存在于本机，不提交到 Git。
#   2. .gitignore 必须忽略 .env.local（当前已忽略）。
#   3. 部署到服务器时按目标环境重新填写，不复用本机取值。
#
# 本文件只保留变量名与说明，不得写入任何真实密钥。
#
# 校验契约由 src/shared/validation/env.ts 唯一定义：非法取值会在
# `next dev` / `next build` / `next start` 启动阶段明确报错，且错误信息不回显取值。

# ── 服务端变量（不得出现在前端代码、日志或客户端包中）──────────────────

# PostgreSQL 连接串。本地开发默认由 docker/compose.dev.yaml 提供实例。
# 校验：可选；一旦填写必须以 postgres: 或 postgresql: 开头。
# 格式：postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# 会话与令牌签名密钥。校验：可选；一旦填写长度至少 32 个字符。
# 本地开发自行生成随机值，例如：
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
AUTH_SECRET=

# AI 供应商适配器标识，默认为 mock。
# 校验：可选；不能是空字符串或纯空白。
AI_PROVIDER=mock

# AI 供应商密钥。校验：当 AI_PROVIDER 不是 mock 时必填。
AI_API_KEY=

# 日志级别，默认为 info。
# 校验：可选；取值必须是 debug | info | warn | error 之一（大小写敏感）。
LOG_LEVEL=debug

# ── 客户端变量（会内联进浏览器包，严禁放置任何秘密）────────────────────

# 界面显示的产品名。只有 NEXT_PUBLIC_ 前缀的变量允许被前端读取。
NEXT_PUBLIC_APP_NAME=Livefil

# ── 进程行为开关 ────────────────────────────────────────────────────────

# 关闭 Next.js 遥测上报，保持项目零外部上报。
NEXT_TELEMETRY_DISABLED=1

# ── 本地数据库容器参数（供 docker/compose.dev.yaml 使用）────────────────
# 留空则使用该文件中的本地开发默认值。
# 本地开发库仅绑定回环地址，默认值不得用于任何非本地环境。
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
